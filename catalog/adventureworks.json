{
  "domain": "sales",
  "description_fa": "فروش اینترنتی، محصولات و مشتریان",
  "hints_fa": [
    "همه مبالغ به دلار است.",
    "برای فیلتر سال و ماه از موجودیت [date] استفاده کن و آن را از طریق [OrderDateKey] به [sales] وصل کن."
  ],
  "permissions": {
    "IT - Data": ["*"],
    "IT - Security": ["*"],
    "NLSQL-Full": ["*"],
    "NLSQL-Sales": ["sales", "product", "subcategory", "category", "customer", "date", "territory"],
    "NLSQL-Finance": ["customer", "date"]
  },
  "entities": [
    {
      "name": "sales",
      "kind": "table",
      "source": "[dbo].[FactInternetSales]",
      "core": true,
      "description_fa": "تراکنش‌های فروش اینترنتی؛ هر ردیف یک قلم از یک سفارش",
      "synonyms_fa": ["فروش", "سفارش", "فاکتور", "درآمد", "مبیعات", "خرید"],
      "columns": [
        { "name": "SalesOrderNumber", "type": "nvarchar", "description_fa": "شماره سفارش", "synonyms_fa": ["شماره سفارش"] },
        { "name": "ProductKey", "type": "int", "description_fa": "کلید محصول" },
        { "name": "CustomerKey", "type": "int", "description_fa": "کلید مشتری" },
        { "name": "SalesTerritoryKey", "type": "int", "description_fa": "کلید منطقه فروش" },
        { "name": "OrderDateKey", "type": "int", "description_fa": "کلید تاریخ سفارش" },
        { "name": "OrderQuantity", "type": "smallint", "description_fa": "تعداد سفارش", "synonyms_fa": ["تعداد", "مقدار"] },
        { "name": "UnitPrice", "type": "money", "description_fa": "قیمت واحد", "synonyms_fa": ["قیمت واحد"] },
        { "name": "SalesAmount", "type": "money", "description_fa": "مبلغ فروش", "synonyms_fa": ["مبلغ", "مبلغ فروش", "ارزش فروش", "درآمد", "فروش ریالی"] },
        { "name": "TotalProductCost", "type": "money", "description_fa": "بهای تمام‌شده کالای فروش‌رفته", "synonyms_fa": ["بهای تمام شده", "هزینه", "قیمت تمام شده"] },
        { "name": "DiscountAmount", "type": "float", "description_fa": "مبلغ تخفیف", "synonyms_fa": ["تخفیف"] },
        { "name": "TaxAmt", "type": "money", "description_fa": "مالیات", "synonyms_fa": ["مالیات"] },
        { "name": "Freight", "type": "money", "description_fa": "هزینه حمل", "synonyms_fa": ["حمل", "کرایه"] },
        { "name": "OrderDate", "type": "datetime", "description_fa": "تاریخ سفارش", "synonyms_fa": ["تاریخ سفارش", "تاریخ"] },
        { "name": "RevisionNumber", "type": "tinyint", "exposed": false },
        { "name": "CarrierTrackingNumber", "type": "nvarchar", "exposed": false }
      ]
    },
    {
      "name": "product",
      "kind": "table",
      "source": "[dbo].[DimProduct]",
      "description_fa": "محصولات",
      "synonyms_fa": ["محصول", "کالا", "جنس", "آیتم"],
      "columns": [
        { "name": "ProductKey", "type": "int", "description_fa": "کلید محصول" },
        { "name": "EnglishProductName", "alias": "ProductName", "type": "nvarchar", "description_fa": "نام محصول", "synonyms_fa": ["نام محصول", "نام کالا"] },
        { "name": "ProductSubcategoryKey", "type": "int", "description_fa": "کلید زیردسته" },
        { "name": "Color", "type": "nvarchar", "description_fa": "رنگ", "synonyms_fa": ["رنگ"] },
        { "name": "Size", "type": "nvarchar", "description_fa": "اندازه", "synonyms_fa": ["اندازه", "سایز"] },
        { "name": "Weight", "type": "float", "description_fa": "وزن", "synonyms_fa": ["وزن"] },
        { "name": "ListPrice", "type": "money", "description_fa": "قیمت لیست", "synonyms_fa": ["قیمت", "قیمت لیست"] },
        { "name": "StandardCost", "type": "money", "description_fa": "بهای استاندارد", "synonyms_fa": ["بهای استاندارد"] },
        { "name": "ModelName", "type": "nvarchar", "description_fa": "نام مدل", "synonyms_fa": ["مدل"] }
      ]
    },
    {
      "name": "subcategory",
      "kind": "table",
      "source": "[dbo].[DimProductSubcategory]",
      "description_fa": "زیردسته محصولات",
      "synonyms_fa": ["زیردسته", "زیر دسته", "زیرگروه"],
      "columns": [
        { "name": "ProductSubcategoryKey", "type": "int", "description_fa": "کلید زیردسته" },
        { "name": "EnglishProductSubcategoryName", "alias": "SubcategoryName", "type": "nvarchar", "description_fa": "نام زیردسته", "synonyms_fa": ["نام زیردسته"] },
        { "name": "ProductCategoryKey", "type": "int", "description_fa": "کلید دسته" }
      ]
    },
    {
      "name": "category",
      "kind": "table",
      "source": "[dbo].[DimProductCategory]",
      "description_fa": "دسته‌بندی محصولات",
      "synonyms_fa": ["دسته", "دسته بندی", "گروه کالا", "طبقه"],
      "columns": [
        { "name": "ProductCategoryKey", "type": "int", "description_fa": "کلید دسته" },
        { "name": "EnglishProductCategoryName", "alias": "CategoryName", "type": "nvarchar", "description_fa": "نام دسته", "synonyms_fa": ["نام دسته"] }
      ]
    },
    {
      "name": "customer",
      "kind": "table",
      "source": "[dbo].[DimCustomer]",
      "description_fa": "مشتریان",
      "synonyms_fa": ["مشتری", "خریدار", "طرف حساب"],
      "columns": [
        { "name": "CustomerKey", "type": "int", "description_fa": "کلید مشتری" },
        { "name": "FirstName", "type": "nvarchar", "description_fa": "نام", "synonyms_fa": ["نام"] },
        { "name": "LastName", "type": "nvarchar", "description_fa": "نام خانوادگی", "synonyms_fa": ["نام خانوادگی", "فامیل"] },
        { "name": "Gender", "type": "nvarchar", "description_fa": "جنسیت M یا F", "synonyms_fa": ["جنسیت", "زن", "مرد"] },
        { "name": "MaritalStatus", "type": "nchar", "description_fa": "وضعیت تاهل M یا S", "synonyms_fa": ["تاهل", "متاهل", "مجرد"] },
        { "name": "YearlyIncome", "type": "money", "description_fa": "درآمد سالانه", "synonyms_fa": ["درآمد سالانه", "حقوق"] },
        { "name": "EnglishEducation", "alias": "Education", "type": "nvarchar", "description_fa": "تحصیلات", "synonyms_fa": ["تحصیلات", "مدرک"] },
        { "name": "EnglishOccupation", "alias": "Occupation", "type": "nvarchar", "description_fa": "شغل", "synonyms_fa": ["شغل", "حرفه"] },
        { "name": "TotalChildren", "type": "tinyint", "description_fa": "تعداد فرزندان", "synonyms_fa": ["فرزند"] },
        { "name": "EmailAddress", "type": "nvarchar", "exposed": false },
        { "name": "BirthDate", "type": "date", "exposed": false }
      ]
    },
    {
      "name": "date",
      "kind": "table",
      "source": "[dbo].[DimDate]",
      "description_fa": "تقویم؛ برای فیلتر و گروه‌بندی زمانی",
      "synonyms_fa": ["تاریخ", "سال", "ماه", "فصل", "روز", "زمان", "دوره"],
      "columns": [
        { "name": "DateKey", "type": "int", "description_fa": "کلید تاریخ" },
        { "name": "FullDateAlternateKey", "alias": "FullDate", "type": "date", "description_fa": "تاریخ کامل میلادی" },
        { "name": "CalendarYear", "type": "smallint", "description_fa": "سال میلادی", "synonyms_fa": ["سال"] },
        { "name": "CalendarQuarter", "type": "tinyint", "description_fa": "سه‌ماهه ۱ تا ۴", "synonyms_fa": ["سه ماهه", "فصل", "ربع"] },
        { "name": "MonthNumberOfYear", "alias": "MonthNumber", "type": "tinyint", "description_fa": "شماره ماه ۱ تا ۱۲", "synonyms_fa": ["ماه"] },
        { "name": "EnglishMonthName", "alias": "MonthName", "type": "nvarchar", "description_fa": "نام ماه", "synonyms_fa": ["نام ماه"] },
        { "name": "EnglishDayNameOfWeek", "alias": "DayName", "type": "nvarchar", "description_fa": "نام روز هفته", "synonyms_fa": ["روز هفته"] }
      ]
    },
    {
      "name": "territory",
      "kind": "table",
      "source": "[dbo].[DimSalesTerritory]",
      "description_fa": "مناطق فروش",
      "synonyms_fa": ["منطقه", "ناحیه", "کشور", "استان", "جغرافیا", "شهر"],
      "columns": [
        { "name": "SalesTerritoryKey", "type": "int", "description_fa": "کلید منطقه" },
        { "name": "SalesTerritoryRegion", "alias": "Region", "type": "nvarchar", "description_fa": "نام منطقه", "synonyms_fa": ["منطقه", "ناحیه"] },
        { "name": "SalesTerritoryCountry", "alias": "Country", "type": "nvarchar", "description_fa": "کشور", "synonyms_fa": ["کشور"] },
        { "name": "SalesTerritoryGroup", "alias": "TerritoryGroup", "type": "nvarchar", "description_fa": "گروه منطقه‌ای مثل North America", "synonyms_fa": ["قاره", "گروه منطقه"] }
      ]
    },
        {
      "name": "sales_detail",
      "kind": "virtual",
      "description_fa": "اقلام فروش؛ هر ردیف یک قلم از یک سفارش. برای گزارش باید تجمیع شود",
      "synonyms_fa": ["فروش", "روند فروش", "فروش ماهانه", "اقلام فروش"],
      "sql": "SELECT f.SalesOrderNumber AS [OrderNumber], d.CalendarYear AS [Year], d.MonthNumberOfYear AS [MonthNumber], d.EnglishMonthName AS [MonthName], c.EnglishProductCategoryName AS [CategoryName], p.EnglishProductName AS [ProductName], f.OrderQuantity AS [Quantity], f.SalesAmount AS [SalesAmount] FROM dbo.FactInternetSales f INNER JOIN dbo.DimDate d ON f.OrderDateKey = d.DateKey INNER JOIN dbo.DimProduct p ON f.ProductKey = p.ProductKey INNER JOIN dbo.DimProductSubcategory s ON p.ProductSubcategoryKey = s.ProductSubcategoryKey INNER JOIN dbo.DimProductCategory c ON s.ProductCategoryKey = c.ProductCategoryKey WHERE f.SalesAmount > 0",
      "columns": [
        { "name": "OrderNumber", "type": "nvarchar", "description_fa": "شماره سفارش" },
        { "name": "Year", "type": "int", "description_fa": "سال میلادی", "synonyms_fa": ["سال"] },
        { "name": "MonthNumber", "type": "int", "description_fa": "شماره ماه ۱ تا ۱۲", "synonyms_fa": ["ماه"] },
        { "name": "MonthName", "type": "nvarchar", "description_fa": "نام ماه" },
        { "name": "CategoryName", "type": "nvarchar", "description_fa": "نام دسته محصول", "synonyms_fa": ["دسته"] },
        { "name": "ProductName", "type": "nvarchar", "description_fa": "نام محصول", "synonyms_fa": ["محصول"] },
        { "name": "Quantity", "type": "int", "description_fa": "تعداد", "synonyms_fa": ["تعداد"] },
        { "name": "SalesAmount", "type": "money", "description_fa": "مبلغ فروش این قلم", "synonyms_fa": ["مبلغ", "فروش"] }
      ]
    }
  ],
  "joins": [
    { "from": "sales", "from_column": "ProductKey", "to": "product", "to_column": "ProductKey", "type": "INNER" },
    { "from": "sales", "from_column": "CustomerKey", "to": "customer", "to_column": "CustomerKey", "type": "INNER" },
    { "from": "sales", "from_column": "SalesTerritoryKey", "to": "territory", "to_column": "SalesTerritoryKey", "type": "INNER" },
    { "from": "sales", "from_column": "OrderDateKey", "to": "date", "to_column": "DateKey", "type": "INNER" },
    { "from": "product", "from_column": "ProductSubcategoryKey", "to": "subcategory", "to_column": "ProductSubcategoryKey", "type": "INNER" },
    { "from": "subcategory", "from_column": "ProductCategoryKey", "to": "category", "to_column": "ProductCategoryKey", "type": "INNER" }
  ],
  "examples": [
    {
      "q": "پرفروش‌ترین ۵ محصول کدام‌اند؟",
      "sql": "SELECT TOP 5 [product].[ProductName], SUM([sales].[SalesAmount]) AS [Total] FROM [sales] INNER JOIN [product] ON [sales].[ProductKey] = [product].[ProductKey] GROUP BY [product].[ProductName] ORDER BY [Total] DESC"
    },
    {
      "q": "فروش هر دسته در سال 2013",
      "sql": "SELECT [category].[CategoryName], SUM([sales].[SalesAmount]) AS [Total] FROM [sales] INNER JOIN [product] ON [sales].[ProductKey] = [product].[ProductKey] INNER JOIN [subcategory] ON [product].[ProductSubcategoryKey] = [subcategory].[ProductSubcategoryKey] INNER JOIN [category] ON [subcategory].[ProductCategoryKey] = [category].[ProductCategoryKey] INNER JOIN [date] ON [sales].[OrderDateKey] = [date].[DateKey] WHERE [date].[CalendarYear] = 2013 GROUP BY [category].[CategoryName] ORDER BY [Total] DESC"
    }
  ]
}
