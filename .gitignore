# Generated by scripts/index-catalog-embeddings.js on each deployment
catalog/*.embeddings.json

# docker-compose volumes: n8n's database (includes its encrypted credentials),
# Open WebUI data and the embedding model cache
n8n_data/
openwebui_data/
embedding/tei-data/

node_modules/
catalog/

# Obsidian vault (obsidian/): shared settings are committed, per-machine state is not.
# Inbox/n8n holds notes written by n8n with real users' questions - never commit them.
obsidian/.obsidian/workspace*.json
obsidian/.obsidian/cache
obsidian/.obsidian/plugins/*/data.json
obsidian/.trash/
obsidian/Inbox/n8n/
# The generated catalog notes are committed; on Windows (case-insensitive) the catalog/ rule above would hide them.
!obsidian/Catalog/
