# Generated by scripts/index-catalog-embeddings.js on each deployment
catalog/*.embeddings.json
# Generated by scripts/index-vault-embeddings.js (indexer-watch): the notes as vectors for the Obsidian assistant
vault-index/
# Trained on the server by scripts/train-retrieval.js (indexer-watch) with the real embeddings; the committed
# keyword-only model is catalog-service/text2sql/baseline-model.json
catalog/retrieval-model.json
# Built from the warehouse by scripts/build-value-index.js: real data (customer,
# supplier and staff names) - never commit it, nor the CSV it was built from.
catalog/values.json
values*.csv

# docker-compose volumes: n8n's database (includes its encrypted credentials),
# Open WebUI data and the embedding model cache
n8n_data/
openwebui_data/
embedding/tei-data/

node_modules/
catalog/

# Benchmark candidates mined from the audit log (scripts/audit-to-benchmark.js) hold
# real users' questions - never commit them.
benchmark/**/*.local.json

# Obsidian vault (obsidian/): shared settings are committed, per-machine state is not.
# Inbox/n8n holds notes written by n8n with real users' questions - never commit them.
obsidian/.obsidian/workspace*.json
obsidian/.obsidian/cache
obsidian/.obsidian/plugins/*/data.json
obsidian/.trash/
obsidian/Inbox/n8n/*
!obsidian/Inbox/n8n/.gitkeep
# Written every day by scripts/system-check.js (indexer-watch) - a status page, not a source file.
obsidian/Inbox/System check.md
# The generated catalog notes are committed; on Windows (case-insensitive) the catalog/ rule above would hide them.
!obsidian/Catalog/
