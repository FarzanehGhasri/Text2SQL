# Copy to .env (never commit .env) and fill in. Read by the text2sql service only.
# READ-ONLY login (db_datareader). ApplicationIntent=ReadOnly lets an Availability Group use a readable secondary.
TEXT2SQL_DB=Driver={ODBC Driver 18 for SQL Server};Server=SQLSERVER_HOST;Database=SA_DataWarehouse;UID=nlsql_reader;PWD=CHANGE_ME;Encrypt=yes;TrustServerCertificate=yes;ApplicationIntent=ReadOnly
# INSERT-only login for [dbo].[NLSQL_AuditLog] (sql/NLSQL_AuditLog.sql). Leave empty to skip auditing.
TEXT2SQL_AUDIT_DB=
# Active Directory: the user whose mail = the e-mail Open WebUI sends.
TEXT2SQL_LDAP_URL=ldap://DC_HOST
TEXT2SQL_LDAP_USER=CORP\svc_nlsql
TEXT2SQL_LDAP_PASSWORD=CHANGE_ME
TEXT2SQL_LDAP_BASE=OU=People,DC=alborz,DC=local
# The key Open WebUI sends (Authorization: Bearer ...). Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
TEXT2SQL_API_KEY=CHANGE_ME
# Only for an OpenAI-compatible model server that needs a key (Settings.md -> Model -> api: openai)
TEXT2SQL_LLM_API_KEY=
